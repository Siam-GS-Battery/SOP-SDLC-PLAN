{
  "__inputs": [
    {
      "name": "ds_prom",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    },
    {
      "name": "ds_pg",
      "label": "PostgreSQL",
      "type": "datasource",
      "pluginId": "grafana-postgresql-datasource",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    }
  ],
  "uid": "sq-exec-overview",
  "title": "Software Quality — Executive Overview",
  "tags": [
    "software-quality",
    "executive"
  ],
  "timezone": "Asia/Bangkok",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "graphTooltip": 1,
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "ds_prom",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "ds_pg",
        "label": "PostgreSQL",
        "type": "datasource",
        "query": "grafana-postgresql-datasource",
        "current": {},
        "hide": 0
      },
      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_prom}"
        },
        "query": {
          "query": "label_values(probe_success, project)",
          "refId": "v"
        },
        "definition": "label_values(probe_success, project)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Quality scorecard per project (30d)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "100 * avg_over_time((avg by (project) (probe_success{project=~\"$project\"}) and on() (hour()*60 + minute() >= 30 and hour()*60 + minute() < 570 and day_of_week() >= 1 and day_of_week() <= 5))[$__range:1m])",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "100 * sum by (project) (increase(http_server_request_duration_seconds_count{project=~\"$project\",status=~\"5..\"}[$__range])) / sum by (project) (increase(http_server_request_duration_seconds_count{project=~\"$project\"}[$__range]))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "histogram_quantile(0.95, sum by (project, le) (rate(http_server_request_duration_seconds_bucket{project=~\"$project\"}[$__range])))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "sum by (project) (increase(job_failures_total{project=~\"$project\"}[$__range]))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds_pg}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT DISTINCT ON (project) project, value FROM quality_metrics WHERE metric = 'new_code_coverage_pct' AND project IN (${project:sqlstring}) ORDER BY project, created_at DESC",
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds_pg}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT DISTINCT ON (project) project, value FROM quality_metrics WHERE metric = 'audit_critical' AND project IN (${project:sqlstring}) ORDER BY project, created_at DESC",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Availability 30d (biz hrs) %"
              },
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 99
                    },
                    {
                      "color": "green",
                      "value": 99.5
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "decimals",
                "value": 2
